{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PolterSense backend",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net8.0/PolterSense.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Production",
                "ASPNETCORE_URLS": "http://127.0.0.1:5279",
                "POLTERSENSE_CONFIG_DIR": "${workspaceFolder}/.poltersense"
            }
        },
        {
            "name": "PolterSense attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
