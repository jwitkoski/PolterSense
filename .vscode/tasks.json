{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": ["build", "${workspaceFolder}/src/PolterSense.csproj"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": ["publish", "${workspaceFolder}/src/PolterSense.csproj", "--configuration", "Release"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": ["watch", "--project", "${workspaceFolder}/src/PolterSense.csproj"],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "frontend",
            "command": "pnpm",
            "type": "process",
            "args": ["-C", "${workspaceFolder}/src/ui", "start"],
            "problemMatcher": []
        }
    ]
}
