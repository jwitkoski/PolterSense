		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/d3": "^7.4.3",
		"@types/d3-interpolate": "^3.0.4",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.8",
		"@types/node": "^26.6.1",
		"d3": "^7.9.0",
