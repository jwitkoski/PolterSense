		"svelte": "^5.57.0",
		"svelte-check": "^4.7.4",
		"svelte-eslint-parser": "^1.8.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^7.3.5",
		"vitest": "^4.1.11"
